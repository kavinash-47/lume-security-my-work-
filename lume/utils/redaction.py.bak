"""Redaction utilities for sensitive data and PII masking."""

import re
from typing import Any, Dict

def redact_sensitive_data(text: str) -> str:
    """Masks sensitive API keys, tokens, and PII in text strings."""
    if not text:
        return ""
    
    # Redact OpenAI / API keys
    text = re.sub(r"sk-[a-zA-Z0-9]{20,}", "[REDACTED_API_KEY]", text, flags=re.IGNORECASE)
    # Redact GitHub tokens
    text = re.sub(r"ghp_[a-zA-Z0-9]{36}", "[REDACTED_GITHUB_TOKEN]", text, flags=re.IGNORECASE)
    # Redact AWS keys
    text = re.sub(r"AKIA[0-9A-Z]{16}", "[REDACTED_AWS_KEY]", text, flags=re.IGNORECASE)
    # Redact Credit Cards
    text = re.sub(r"\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|6011[0-9]{12})\b", "[REDACTED_CREDIT_CARD]", text)
    # Redact SSNs
    text = re.sub(r"\b\d{3}-\d{2}-\d{4}\b", "[REDACTED_SSN]", text)
    
    return text

def redact_sensitive_text(text: str) -> str:
    """Alias for Evidence collector compatibility."""
    return redact_sensitive_data(text)

def redact_dictionary(data: Dict[str, Any]) -> Dict[str, Any]:
    """Recursively redacts sensitive values inside a dictionary."""
    if not isinstance(data, dict):
        return data
    
    redacted = {}
    for k, v in data.items():
        if isinstance(v, str):
            redacted[k] = redact_sensitive_data(v)
        elif isinstance(v, dict):
            redacted[k] = redact_dictionary(v)
        elif isinstance(v, list):
            redacted[k] = [
                redact_dictionary(item) if isinstance(item, dict) else (redact_sensitive_data(item) if isinstance(item, str) else item)
                for item in v
            ]
        else:
            redacted[k] = v
    return redacted

